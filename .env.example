# Copy to .env and fill in. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/joinstudy

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=28d
# Sign people out after this many minutes without activity (caps both lifetimes above). 0 = off.
SESSION_IDLE_MINUTES=20

# Optional. Leave empty to run without Redis.
REDIS_URL=

# The React app. Used for links in emails.
FRONTEND_URL=http://localhost:5173
# Comma-separated sites allowed to call the API. Required in production.
CORS_ORIGINS=http://localhost:5173

# Email (any SMTP provider: Postmark, SendGrid, Resend, SES…).
# With SMTP_HOST empty, emails are printed to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=joinStudy <hello@joinstudy.io>
REQUIRE_EMAIL_VERIFICATION=true
LEADS_INBOX=hello@joinstudy.io

# Firebase service account, for "Continue with Google".
# Firebase console → Project settings → Service accounts → Generate new private key.
# Must be the same Firebase project as the frontend's VITE_GOOGLE_PROJECT_ID. Paste "private_key" whole (quotes and \n are fine).
# Test the settings with: npm run check-google -- <frontend project id>
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Business rules (placeholders: set your real policy)
PLATFORM_FEE_RATE=0.22
ACADEMIC_FEE_RATE=0.18
# Extra academic email domains, comma-separated (most .edu / .ac.xx / .edu.xx are recognised already)
ACADEMIC_DOMAINS=
# Smallest cash-out, in DEFAULT_CURRENCY
MIN_PAYOUT_AMOUNT=5
# Hourly pay, in DEFAULT_CURRENCY (US dollars). Left out, they're 4 and 8 for US dollars (and unset for other currencies).
# Hard floor: a study can't launch below this.
MIN_HOURLY_PAY=4
# The suggestion: researchers see a warning below it, and the cost estimate starts here.
RECOMMENDED_HOURLY_PAY=8
# Studies are priced and paid in US dollars; participants convert at cash-out
DEFAULT_CURRENCY=USD

# Participant Stage 1
# Countries participants can sign up from (anyone else joins a waitlist).
PARTICIPANT_COUNTRIES=Nigeria,Ghana,Kenya
# Cloudflare Turnstile secret for the sign-up bot check (free). Empty = skipped.
TURNSTILE_SECRET=
# Verify participants once (WhatsApp/SMS code + selfie) before their first study.
REQUIRE_PARTICIPANT_VERIFICATION=true
# "test" providers write codes to the log / let you pick the selfie result, and refuse to run in production.
# Phone codes: Termii (termii.com). Dashboard → API & Webhooks: copy the API key and the base URL shown there.
# Sender ID: Termii dashboard → Sender ID → request one (e.g. joinStudy) and wait for approval.
PHONE_PROVIDER=termii
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=joinStudy
# dnd = transactional route (reaches Do-Not-Disturb numbers; recommended for codes in Nigeria). Or generic.
TERMII_CHANNEL=dnd
# WhatsApp codes: ask Termii support to switch on WhatsApp OTP, then put the WhatsApp device/sender name here.
# Leave empty and "Send code on WhatsApp" sends a text instead.
TERMII_WHATSAPP_FROM=
# Selfie: Smile ID SmartSelfie registration (usesmileid.com). Portal → Developers → API keys (sandbox and production
# keys differ). Ask Smile ID to switch on Smile Secure so a face already on another account comes back as a duplicate.
SELFIE_PROVIDER=smileid
SMILEID_PARTNER_ID=
SMILEID_API_KEY=
SMILEID_ENV=sandbox
# Smile ID posts results here. Must be your public API address over https.
SMILEID_CALLBACK_URL=https://api.joinstudy.io/api/verification/smileid/webhook
SMILEID_COMPANY_NAME=joinStudy
SMILEID_LOGO_URL=https://www.joinstudy.io/joinstudy-logo-icon.png
SMILEID_POLICY_URL=https://www.joinstudy.io/privacy
# Secret for hashing phone numbers. Set a long random value in production.
PHONE_HASH_SECRET=change-me-phone

# Participant Stage 2: "Connect LinkedIn" (optional). A LinkedIn app with Sign In with LinkedIn using OpenID Connect.
# Redirect URL to register: <FRONTEND_URL>/participate/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Stage 5: payments. Leave the Stripe keys empty in development to use the built-in test card flow.
# In production, card payments need all three (without them researchers are offered an invoice):
#   Stripe → Developers → API keys: the secret key (sk_live_…) and the publishable key (pk_live_…), a matching pair.
#   Stripe → Developers → Webhooks: add <API address>/api/billing/webhook with the event payment_intent.succeeded,
#   then copy its signing secret (whsec_…).
# Test them with: npm run check-stripe -- <API address, e.g. https://api.joinstudy.io>
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# joinStudy's company bank details for invoices (use \n for new lines). Never a personal account.
INVOICE_BANK_DETAILS=
# Where "a study is waiting for review" emails go (defaults to LEADS_INBOX)
REVIEW_INBOX=
# After payment a study waits for the researcher to click "Publish now" (they can tick "Publish automatically when the
# payment arrives" at checkout). true: joinStudy reviews it first, then it waits for "Publish now".
REVIEW_BEFORE_PUBLISH=false
# Participant Stage 7: the Help contact form, and reports about studies (both default to LEADS_INBOX)
SUPPORT_INBOX=support@joinstudy.io
TRUST_INBOX=trust@joinstudy.io

# Participant Stage 6: who sends cash-outs (bank, mobile money, airtime, PayPal). "test" until one is chosen; refused in production.
PAYOUT_PROVIDER=test

# Refer a friend (researchers). A friend who signs up with your link pays ACADEMIC_FEE_RATE on their first study.
# You earn credit: REFERRAL_SHARE of their fees in their first REFERRAL_WINDOW_DAYS, at most REFERRAL_FRIEND_CAP per
# friend and REFERRAL_YEAR_CAP a year (amounts in DEFAULT_CURRENCY). Credit expires after REFERRAL_CREDIT_MONTHS.
# REFERRALS=false hides the feature and stops new rewards.
REFERRALS=true
REFERRAL_SHARE=0.25
REFERRAL_WINDOW_DAYS=90
REFERRAL_FRIEND_CAP=25
REFERRAL_YEAR_CAP=250
REFERRAL_CREDIT_MONTHS=12
# Participants: a waitlist per country. Room = WAITLIST_MIN_SEATS + WAITLIST_PLACES_FACTOR x open places in live
# studies for that country. People already active stay active; invites move waiting people up the queue.
PARTICIPANT_WAITLIST=true
WAITLIST_MIN_SEATS=300
WAITLIST_PLACES_FACTOR=3
# Cash (in DEFAULT_CURRENCY) for a participant once an invited friend has PARTICIPANT_REFERRAL_STUDIES studies approved. 0 = none.
PARTICIPANT_REFERRAL_REWARD=0
PARTICIPANT_REFERRAL_STUDIES=3
